# Redis (Celery broker + result backend)
REDIS_URL=redis://redis:6379/0

# Where the Wan2.2 repo is cloned and where weights live (see scripts/).
# Lives under /data/shasegawa (shared host storage), which docker-compose
# also bind-mounts at this same absolute path, so this value works
# unchanged whether you run harmonize_cli.py directly on the host or inside
# a worker container.
WAN_REPO_DIR=/data/shasegawa/vendor/Wan2.2
WAN_CKPT_DIR=/data/shasegawa/vendor/Wan2.2-Animate-14B

# Storage paths (mounted volume shared by api + workers)
DATA_DIR=/data/shasegawa
UPLOADS_DIR=/data/shasegawa/uploads
OUTPUTS_DIR=/data/shasegawa/outputs

# Generation defaults. animate-14B only supports 1280*720 or 720*1280
# (wan/configs/__init__.py SUPPORTED_SIZES) — not the 832*480 t2v/i2v examples use.
WAN_SIZE=1280*720
WAN_FRAME_NUM=81
WAN_USE_RELIGHTING_LORA=true

# GPU assignment for THIS worker process.
# Comma-separated physical GPU indices this worker instance is allowed to use.
# Single-GPU worker: "0". Multi-GPU FSDP worker sharding one job across GPUs: "0,1,2,3".
WORKER_GPUS=0

# If WORKER_GPUS lists more than one GPU, the pipeline launches generate.py via
# torchrun with --dit_fsdp --t5_fsdp --ulysses_size=<num GPUs>. Otherwise it runs
# generate.py directly on the single assigned GPU.

# Root directory for all NEW pipeline artifacts (model caches, motion clip
# library, per-job intermediate/output files). Kept separate from the
# original Wan2.2 vendor/uploads/outputs paths above. Large — must live on
# the /data volume, never inside the git checkout.
HARMONIZE_DATA_DIR=/data/shasegawa/harmonize

# Claude API key. Required by the scene parser (keyframe captioning) and the
# behavior planner (semantic action + dialogue generation) — the pipeline
# raises a clear error at startup if this is unset, it does not silently
# skip those stages.
ANTHROPIC_API_KEY=

# Optional. Enables spoken dialogue via DashScope TTS (CosyVoice). If unset,
# the pipeline still runs end-to-end but dialogue is burned in as subtitles
# only, no voice audio.
DASHSCOPE_API_KEY=
